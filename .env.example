# ==============================================================================
# SentinelAI Environment Configuration (.env)
# ==============================================================================

# 1. Database Configuration
# Default uses local SQLite for instant setup.
# For PostgreSQL (via Docker Compose), use:
# DATABASE_URL=postgresql://sentinel:sentinel_pass@localhost:5432/sentinel_db
DATABASE_URL=sqlite:///./sentinelai.db

# 2. AI Engine Configuration
# Options: "mock" (default, deterministic evidence-based analysis), "openai", "gemini", "ollama"
AI_PROVIDER=mock

# OpenAI Configuration (if AI_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Google Gemini Configuration (if AI_PROVIDER=gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Ollama Local LLM Configuration (if AI_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# 3. Threat Intelligence / IOC Enrichment Configuration
# Options: "mock" (uses built-in threat intel DB + heuristics), "live" (queries AbuseIPDB & VirusTotal)
IOC_MODE=mock
ABUSEIPDB_API_KEY=
VIRUSTOTAL_API_KEY=

# 4. 2FA & Security Encryption Settings
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOTP_ENCRYPTION_KEY=U2VudGluZWxBSV8yRkFfRmVybmV0X0tleV8yMDI2X1NPQ19TZWMy
BOOTSTRAP_USERNAME=admin
BOOTSTRAP_PASSWORD=Admin@2026

# 5. Application Settings
APP_ENV=development
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
